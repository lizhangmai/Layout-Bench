    "sg13g2-model-calls.lvs": {
      "format": "ruby",
      "content": "# Adapt ngspice model calls to the pinned SG13G2 native LVS reader.\n# Only these reviewed device interfaces are consumed as primitives; ordinary\n# hierarchical X instances retain KLayout's default subcircuit handling.\n# The upstream include reopens this class with its native implementation.\nclass CustomReader < RBA::NetlistSpiceReaderDelegate\nend\n\nmodule SG13G2ModelCalls\n  KINDS = {\n    'sg13_lv_nmos' => 'M', 'sg13_lv_pmos' => 'M',\n    'cap_cmim' => 'C', 'ntap1' => 'R', 'ptap1' => 'R'\n  }.freeze\n\n  def wants_subcircuit(name)\n    KINDS.key?(name.downcase)\n  end\n\n  def element(circuit, kind, name, model, value, nets, params)\n    mapped = KINDS[model.downcase] if kind == 'X'\n    if mapped\n      # Dispatch back through CustomReader, keeping its device classes,\n      # terminal mapping, parameter scaling and comparison semantics.\n      return super(circuit, mapped, name, model.downcase, value, nets, params)\n    end\n    super\n  end\nend\n\nCustomReader.prepend(SG13G2ModelCalls)\n# %include ihp-sg13g2/libs.tech/klayout/tech/lvs/sg13g2.lvs\n"
